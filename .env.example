# Copy this file to .env and fill it in. Netlify reads the same names from
# Site settings > Environment variables. All three are read at build time.

# Meta (Facebook) pixel ID. Numbers only. Leave blank to turn the pixel off.
PUBLIC_META_PIXEL_ID=

# Your Calendly event link, for example https://calendly.com/cayden/20min
PUBLIC_CALENDLY_URL=

# GoHighLevel inbound webhook URL. The /call form posts JSON here.
PUBLIC_GHL_WEBHOOK_URL=
