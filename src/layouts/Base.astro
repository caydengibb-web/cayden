---
/**
 * Shared page shell. Head tags, fonts, pixel, global styles.
 */
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Keep the page out of search. Used on /call and /booked. */
  noindex?: boolean;
  /** Path of this page, for the canonical URL. */
  path: string;
  /** Extra class on <body>, per page. */
  bodyClass?: string;
}

const { title, description, noindex = false, path, bodyClass = '' } = Astro.props;
const siteUrl = site.links.siteUrl.replace(/\/$/, '');
const canonical = `${siteUrl}${path === '/' ? '' : path}`;
const ogImage = `${siteUrl}/og.png`;
const pixelId = (import.meta.env.PUBLIC_META_PIXEL_ID ?? '').trim();
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0B0B0B" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_CA" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="preload"
      href="/fonts/inter-tight-latin-800-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-tight-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Turn motion on only when JS runs and the visitor has not asked for less motion. -->
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
      }
    </script>

    <!-- Meta pixel. ID comes from PUBLIC_META_PIXEL_ID. Off when blank. -->
    {
      pixelId ? (
        <script is:inline define:vars={{ pixelId }}>
          !(function (f, b, e, v, n, t, s) {
            if (f.fbq) return;
            n = f.fbq = function () {
              n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
            };
            if (!f._fbq) f._fbq = n;
            n.push = n;
            n.loaded = !0;
            n.version = '2.0';
            n.queue = [];
            t = b.createElement(e);
            t.async = !0;
            t.src = v;
            s = b.getElementsByTagName(e)[0];
            s.parentNode.insertBefore(t, s);
          })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', pixelId);
          fbq('track', 'PageView');
        </script>
      ) : (
        <script is:inline>
          /* No pixel ID set. Calls to fbq() do nothing. */
          window.fbq = function () {};
        </script>
      )
    }

    <!--
      GA4 goes here when you want it.
      Paste the gtag.js snippet from Google Analytics > Admin > Data streams.
      Keep it below the Meta pixel so the pixel loads first.
    -->
  </head>
  <body class={bodyClass}>
    {
      pixelId && (
        <noscript>
          <img
            height="1"
            width="1"
            style="display:none"
            alt=""
            src={`https://www.facebook.com/tr?id=${pixelId}&ev=PageView&noscript=1`}
          />
        </noscript>
      )
    }
    <slot />
  </body>
</html>
