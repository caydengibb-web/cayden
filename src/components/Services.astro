---
/**
 * The six kinds of video, stacked as one big word per row, centred.
 * Hover a row on desktop and a still follows the cursor.
 */
const rows = [
  { title: 'Leadership videos', line: 'Your people talking to camera about what the company does and why.', still: '/img/still-16x9.jpg' },
  { title: 'Company brand videos', line: 'Two to five minutes, made for your website and sales team.', still: '/img/still-16x9.jpg' },
  { title: 'Client case studies', line: 'Your best client telling the story of working with you.', still: '/img/still-16x9.jpg' },
  { title: 'Recruiting videos', line: 'Made for the roles you can’t fill.', still: '/img/still-16x9.jpg' },
  { title: 'Short clips for LinkedIn and Instagram', line: 'Cut from everything above, posted every week.', still: '/img/still-9x16.jpg' },
  { title: 'Meta ads', line: 'Real video, real budget, aimed at the clients you want.', still: '/img/still-9x16.jpg' },
];
---

<ul class="menu plain-list" data-services>
  {
    rows.map((r, i) => (
      <li class="menu__row" data-reveal data-preview={r.still} style={`--hue: ${i * 7}deg`}>
        <span class="menu__title">{r.title}</span>
        <span class="menu__line muted">{r.line}</span>
      </li>
    ))
  }
</ul>

<style>
  .menu {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4vw, 56px);
    text-align: center;
  }
  .menu__row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .menu__title {
    display: block;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(30px, 5.2vw, 76px);
    letter-spacing: -0.045em;
    line-height: 1;
    text-wrap: balance;
    transition: color 220ms ease, letter-spacing 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .menu__line {
    max-width: 44ch;
    font-size: clamp(15px, 1.1vw, 17px);
  }
  @media (min-width: 900px) {
    .menu__row:hover .menu__title {
      color: var(--orange);
      letter-spacing: -0.02em;
    }
  }
</style>
