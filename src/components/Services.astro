---
/**
 * The six kinds of video. Hover a row on desktop and a still follows the
 * cursor. On phones a small still sits in the row.
 */
const rows = [
  { title: 'Leadership videos.', line: 'Your people talking to camera about what the company does and why.', still: '/img/still-16x9.jpg' },
  { title: 'Company brand videos.', line: 'Two to five minutes, made for your website and sales team.', still: '/img/still-16x9.jpg' },
  { title: 'Client case studies.', line: 'Your best client telling the story of working with you.', still: '/img/still-16x9.jpg' },
  { title: 'Recruiting videos.', line: 'Made for the roles you can’t fill.', still: '/img/still-16x9.jpg' },
  { title: 'Short clips for LinkedIn and Instagram.', line: 'Cut from everything above, posted every week.', still: '/img/still-9x16.jpg' },
  { title: 'Meta ads.', line: 'Real video, real budget, aimed at the clients you want.', still: '/img/still-9x16.jpg' },
];
---

<ul class="services plain-list" data-services>
  {
    rows.map((r, i) => (
      <li class="services__row" data-reveal data-preview={r.still} style={`--hue: ${i * 6}deg`}>
        <strong class="services__title">{r.title}</strong>
        <span class="services__line muted">{r.line}</span>
        <img class="services__thumb" src={r.still} alt="" width="160" height="90" loading="lazy" decoding="async" />
      </li>
    ))
  }
</ul>


<style>
  .services {
    margin-top: clamp(56px, 8vw, 104px);
  }
  .services__row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 80px;
    grid-template-areas:
      'title thumb'
      'line thumb';
    gap: 6px 20px;
    align-items: center;
    transition: color 200ms ease;
  }
  .services__title {
    grid-area: title;
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1), color 200ms ease;
  }
  .services__line {
    grid-area: line;
  }
  .services__thumb {
    grid-area: thumb;
    width: 80px;
    height: 45px;
    object-fit: cover;
    border-radius: 3px;
    filter: sepia(0.4) saturate(1.4) hue-rotate(var(--hue));
  }
  @media (min-width: 900px) {
    .services__row {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      grid-template-areas: 'title line';
      gap: 24px;
      align-items: baseline;
    }
    .services__thumb {
      display: none;
    }
    .services__row:hover .services__title {
      transform: translateX(16px);
      color: var(--accent);
    }
  }
</style>
