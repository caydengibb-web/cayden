---
/** One line of the six video types, looping across the screen. */
const items = [
  'Leadership videos',
  'Company brand videos',
  'Client case studies',
  'Recruiting videos',
  'Short clips for LinkedIn and Instagram',
  'Meta ads',
];
---

<div class="marquee theme-dark" aria-hidden="true">
  <div class="marquee__track" data-marquee>
    {
      [0, 1].map(() => (
        <div class="marquee__group">
          {items.map((t) => (
            <span class="marquee__item">
              {t}
              <span class="marquee__dot" />
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 22px 0;
  }
  .marquee__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }
  .marquee__group {
    display: flex;
    flex-shrink: 0;
  }
  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 40px;
    padding-right: 40px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(28px, 4vw, 56px);
    letter-spacing: -0.035em;
    line-height: 1;
    white-space: nowrap;
    color: var(--muted);
  }
  .marquee__dot {
    width: 10px;
    height: 10px;
    background: var(--orange);
    display: inline-block;
  }
</style>
