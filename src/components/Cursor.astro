---
/** Custom cursor and the floating hover preview. Mouse and trackpad only. */
---

<div class="preview" data-preview-float aria-hidden="true">
  <img src="/img/still-16x9.jpg" alt="" width="1280" height="720" data-preview-img />
</div>
<div class="cursor" data-cursor aria-hidden="true">
  <div class="cursor__dot" data-cursor-dot></div>
  <div class="cursor__ring" data-cursor-ring>
    <span class="cursor__label mono" data-cursor-label></span>
  </div>
</div>

<style>
  .preview {
    display: none;
  }
  @media (min-width: 900px) {
    html.motion.fine .preview {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 1;
      width: 440px;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      pointer-events: none;
      opacity: 0;
    }
  }
  .preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(0.4) saturate(1.3) hue-rotate(var(--hue, 0deg));
  }
  .cursor {
    display: none;
  }
  html.motion.fine .cursor {
    display: block;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    pointer-events: none;
  }
  .cursor__dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 6px;
    height: 6px;
    margin: -3px 0 0 -3px;
    background: var(--ink);
    border-radius: 50%;
  }
  .cursor__ring {
    position: absolute;
    top: 0;
    left: 0;
    width: 36px;
    height: 36px;
    margin: -18px 0 0 -18px;
    border: 1px solid rgba(17, 17, 16, 0.5);
    border-radius: 50%;
    display: grid;
    place-items: center;
    transition: width 220ms ease, height 220ms ease, margin 220ms ease, background-color 220ms ease, border-color 220ms ease;
  }
  .cursor.is-label .cursor__ring {
    width: 84px;
    height: 84px;
    margin: -42px 0 0 -42px;
    background: var(--orange);
    border-color: var(--orange);
  }
  .cursor.is-label .cursor__dot {
    opacity: 0;
  }
  .cursor__label {
    color: var(--ink);
    opacity: 0;
    transition: opacity 160ms ease;
  }
  .cursor.is-label .cursor__label {
    opacity: 1;
  }
  .cursor.is-hidden {
    opacity: 0;
  }
</style>
