---
/** Custom cursor. Only shown for mouse and trackpad users with motion on. */
---

<div class="preview" data-preview-float aria-hidden="true">
  <img src="/img/still-16x9.jpg" alt="" width="1280" height="720" data-preview-img />
</div>
<div class="cursor" data-cursor aria-hidden="true">
  <div class="cursor__dot" data-cursor-dot></div>
  <div class="cursor__ring" data-cursor-ring>
    <span class="cursor__label" data-cursor-label></span>
  </div>
</div>

<style>
  .preview {
    display: none;
  }
  @media (min-width: 900px) {
    html.motion.fine .preview {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 40;
      width: 320px;
      aspect-ratio: 16 / 9;
      border-radius: 4px;
      overflow: hidden;
      pointer-events: none;
      opacity: 0;
    }
  }
  .preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(0.4) saturate(1.4) hue-rotate(var(--hue, 0deg));
  }
  .cursor {
    display: none;
  }
  html.motion.fine .cursor {
    display: block;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    pointer-events: none;
  }
  .cursor__dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    background: var(--orange);
    border-radius: 50%;
  }
  .cursor__ring {
    position: absolute;
    top: 0;
    left: 0;
    width: 40px;
    height: 40px;
    margin: -20px 0 0 -20px;
    border: 1px solid rgba(255, 106, 26, 0.8);
    border-radius: 50%;
    display: grid;
    place-items: center;
    transition: width 220ms ease, height 220ms ease, margin 220ms ease, background-color 220ms ease;
  }
  .cursor.is-label .cursor__ring {
    width: 88px;
    height: 88px;
    margin: -44px 0 0 -44px;
    background: var(--orange);
    border-color: var(--orange);
  }
  .cursor.is-label .cursor__dot {
    opacity: 0;
  }
  .cursor__label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #0b0b0b;
    opacity: 0;
    transition: opacity 160ms ease;
  }
  .cursor.is-label .cursor__label {
    opacity: 1;
  }
  .cursor.is-hidden {
    opacity: 0;
  }
</style>
