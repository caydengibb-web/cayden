---
import { approvedStats } from '../data/site';
const stats = approvedStats();
---

{
  stats.length > 0 && (
    <dl class="stats" data-reveal>
      {stats.map((s) => (
        <div class="stat">
          <dd class="stat__value" data-count={s.value}>{s.value}</dd>
          <dt class="stat__label">{s.label}</dt>
        </div>
      ))}
    </dl>
  )
}

<style>
  .stats {
    display: grid;
    gap: 40px;
    margin: clamp(64px, 8vw, 120px) 0 0;
    padding-top: 48px;
    border-top: 1px solid var(--rule);
  }
  @media (min-width: 720px) {
    .stats {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }
  }
  .stat {
    display: flex;
    flex-direction: column;
  }
  .stat__value {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(80px, 12vw, 180px);
    letter-spacing: -0.06em;
    line-height: 0.86;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    order: 1;
  }
  .stat__label {
    margin-top: 16px;
    font-size: 17px;
    color: var(--muted);
    order: 2;
    max-width: 22ch;
  }
</style>
