---
import { approvedStats } from '../data/site';
const stats = approvedStats();
---

{
  stats.length > 0 && (
    <dl class="stats" data-reveal>
      {stats.map((s) => (
        <div class="stat">
          <dd class="stat__value">{s.value}</dd>
          <dt class="stat__label muted">{s.label}</dt>
        </div>
      ))}
    </dl>
  )
}

<style>
  .stats {
    display: grid;
    gap: 40px;
    margin: 96px 0 0;
    padding-top: 48px;
    border-top: 1px solid var(--rule);
  }
  @media (min-width: 720px) {
    .stats {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
  }
  .stat {
    display: flex;
    flex-direction: column;
  }
  .stat__value {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(72px, 10vw, 148px);
    letter-spacing: -0.05em;
    line-height: 0.9;
    color: var(--orange);
    font-variant-numeric: tabular-nums;
    order: 1;
  }
  .stat__label {
    margin-top: 14px;
    font-size: 17px;
    order: 2;
    max-width: 22ch;
  }
</style>
