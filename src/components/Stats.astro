---
import { approvedStats } from '../data/site';
const stats = approvedStats();
---

{
  stats.length > 0 && (
    <dl class="stats" data-reveal>
      {stats.map((s) => (
        <div class="stat">
          <dd class="stat__value" data-count={s.value}>{s.value}</dd>
          <dt class="stat__label mono muted">{s.label}</dt>
        </div>
      ))}
    </dl>
  )
}

<style>
  .stats {
    display: grid;
    gap: 48px;
    margin: clamp(80px, 12vw, 160px) 0 0;
    text-align: center;
  }
  @media (min-width: 720px) {
    .stats {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }
  }
  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .stat__value {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(88px, 14vw, 220px);
    letter-spacing: -0.07em;
    line-height: 0.84;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    order: 1;
  }
  .stat__label {
    margin-top: 20px;
    order: 2;
    max-width: 24ch;
  }
</style>
