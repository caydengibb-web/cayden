---
import VimeoEmbed from './VimeoEmbed.astro';
import { approvedTestimonials } from '../data/site';

interface Props {
  max?: number;
}
const { max = 3 } = Astro.props;
const list = approvedTestimonials().slice(0, max);
---

{
  list.length > 0 && (
    <ul class="testimonials plain-list">
      {list.map((t) => (
        <li class="testimonial" data-scale>
          <VimeoEmbed vimeoId={t.vimeoId} poster={t.poster} title={`${t.name}, ${t.company}`} />
          <p class="testimonial__who mono">
            <span>{t.name}</span>
            <span class="muted">
              {t.title}, {t.company}
            </span>
          </p>
        </li>
      ))}
    </ul>
  )
}

<style>
  .testimonials {
    display: grid;
    gap: 56px 32px;
  }
  @media (min-width: 720px) {
    .testimonials {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .testimonial:nth-child(2) {
      margin-top: 120px;
    }
  }
  .testimonial__who {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin-top: 14px;
  }
</style>
