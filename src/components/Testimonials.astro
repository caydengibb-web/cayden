---
import VimeoEmbed from './VimeoEmbed.astro';
import { approvedTestimonials } from '../data/site';

interface Props {
  /** Cap the number shown. Home shows up to 3, /call shows 2. */
  max?: number;
}
const { max = 3 } = Astro.props;
const list = approvedTestimonials().slice(0, max);
---

{
  list.length > 0 && (
    <ul class="testimonials plain">
      {list.map((t) => (
        <li class="testimonial" data-scale>
          <VimeoEmbed vimeoId={t.vimeoId} poster={t.poster} title={`${t.name}, ${t.company}`} />
          <p class="testimonial__who">
            <span class="testimonial__name">{t.name}</span>
            <span class="muted">
              {t.title}, {t.company}
            </span>
          </p>
        </li>
      ))}
    </ul>
  )
}

<style>
  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .testimonials {
    display: grid;
    gap: 40px 24px;
  }
  @media (min-width: 720px) {
    .testimonials {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .testimonial__who {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 12px;
    margin-top: 14px;
    font-size: 15px;
    line-height: 1.4;
  }
  .testimonial__name {
    font-weight: 800;
  }
</style>
