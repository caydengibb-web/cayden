---
/** Work. Pins and scrolls sideways on desktop, stacks on phones. Approved clients only. */
import VimeoEmbed from './VimeoEmbed.astro';
import { approvedClients } from '../data/site';

const items = approvedClients().flatMap((client) =>
  client.videos.map((video) => ({ client, video }))
);
---

<section class="work" id="work" data-work>
  <div class="work__pin" data-work-pin>
    <div class="work__track" data-work-track>
      <div class="work__intro">
        <span class="label">Work</span>
        <h2 data-lines>Recent work.</h2>
      </div>
      {
        items.map(({ client, video }, i) => (
          <figure class:list={['work__item', `work__item--${video.ratio}`]} data-scale>
            <VimeoEmbed vimeoId={video.vimeoId} ratio={video.ratio} poster={video.poster} title={`${client.name}: ${video.label}`} />
            <figcaption class="work__meta mono">
              <span>{client.name}</span>
              <span class="muted">{video.label}</span>
              <span class="muted work__idx">{String(i + 1).padStart(2, '0')} / {String(items.length).padStart(2, '0')}</span>
            </figcaption>
          </figure>
        ))
      }
      <div class="work__end">
        <a href="/call" class="btn btn--primary btn--lg" data-magnetic data-cursor="Book">Book a call</a>
      </div>
    </div>
    <div class="work__progress" aria-hidden="true"><span data-work-progress></span></div>
  </div>
</section>

<style>
  .work {
    position: relative;
    overflow: hidden;
  }
  .work__pin {
    position: relative;
    padding: var(--section) 0;
  }
  .work__track {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding: 0 var(--gutter);
  }
  .work__intro {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .work__item {
    margin: 0;
    flex-shrink: 0;
  }
  .work__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    margin-top: 14px;
  }
  .work__idx {
    margin-left: auto;
  }
  .work__end {
    display: flex;
    align-items: center;
  }
  .work__progress {
    display: none;
  }

  @media (min-width: 900px) {
    html:not(.motion) .work__pin {
      height: auto;
      padding: var(--section) 0;
    }
    html:not(.motion) .work__track {
      width: auto;
      overflow-x: auto;
      padding-bottom: 24px;
    }
    html:not(.motion) .work__progress {
      display: none;
    }
    .work__pin {
      height: 100svh;
      padding: 0;
      display: flex;
      align-items: center;
    }
    .work__track {
      flex-direction: row;
      align-items: flex-end;
      gap: clamp(40px, 5vw, 96px);
      width: max-content;
      will-change: transform;
    }
    .work__intro {
      width: 30vw;
      height: 34vw;
      max-height: 58svh;
    }
    .work__item--16x9 :global(.video) {
      width: 58vw;
      max-width: 980px;
    }
    .work__item--9x16 :global(.video) {
      width: 18.4vw;
      max-width: 310px;
    }
    .work__end {
      width: 30vw;
      height: 34vw;
      max-height: 58svh;
      justify-content: center;
    }
    .work__progress {
      display: block;
      position: absolute;
      left: var(--gutter);
      right: var(--gutter);
      bottom: 28px;
      height: 1px;
      background: var(--rule);
    }
    .work__progress span {
      display: block;
      height: 100%;
      width: 100%;
      background: var(--ink);
      transform: scaleX(0);
      transform-origin: left;
    }
  }
</style>
