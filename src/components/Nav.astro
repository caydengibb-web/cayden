---
import { site } from '../data/site';
---

<header class="nav" data-nav>
  <div class="wrap nav__row">
    <a href="/" class="nav__mark mono" aria-label={`${site.name} home`} data-nav-tuck>{site.name}</a>
    <nav aria-label="Main" class="nav__nav" data-nav-tuck>
      <ul class="nav__links mono">
        <li><a href="#what-we-do" data-scroll-to>What we do</a></li>
        <li><a href="#work" data-scroll-to>Work</a></li>
        <li><a href="#results" data-scroll-to>Results</a></li>
      </ul>
    </nav>
    <a href="/call" class="btn btn--primary nav__cta" data-magnetic>Book a call</a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    pointer-events: none;
  }
  .nav__row {
    display: flex;
    align-items: center;
    gap: 32px;
    padding-top: 20px;
  }
  .nav__row > * {
    pointer-events: auto;
  }
  [data-nav-tuck] {
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1), opacity 300ms ease;
  }
  .nav.is-tucked [data-nav-tuck] {
    transform: translateY(-160%);
    opacity: 0;
    pointer-events: none;
  }
  .nav__mark {
    color: var(--ink);
    white-space: nowrap;
  }
  .nav__nav {
    margin-left: auto;
  }
  .nav__links {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 28px;
    color: var(--muted);
  }
  .nav__links a:hover {
    color: var(--ink);
  }
  .nav__cta {
    margin-left: auto;
    min-height: 40px;
    padding: 0 16px;
    font-size: 13px;
  }
  @media (min-width: 900px) {
    .nav__links {
      display: flex;
    }
    .nav__cta {
      margin-left: 0;
    }
  }
</style>
