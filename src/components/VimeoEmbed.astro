---
/**
 * Lazy Vimeo player. Dark box with a still and a play mark; the iframe
 * is added on click, or right away for load="now". No vimeoId = placeholder.
 */
import type { Ratio } from '../data/site';

interface Props {
  vimeoId: string;
  ratio?: Ratio;
  poster?: string;
  title: string;
  load?: 'click' | 'now';
  autoplayMuted?: boolean;
  class?: string;
}

const { vimeoId, ratio = '16x9', poster, title, load = 'click', autoplayMuted = false, class: className = '' } = Astro.props;
const still = poster ?? (ratio === '9x16' ? '/img/still-9x16.jpg' : '/img/still-16x9.jpg');
const hasVideo = vimeoId.trim().length > 0;
---

<div
  class:list={['video', 'corners', `video--${ratio}`, className, { 'video--empty': !hasVideo }]}
  data-video
  data-cursor="Play"
  data-vimeo-id={hasVideo ? vimeoId : undefined}
  data-load={load}
  data-autoplay-muted={autoplayMuted ? '1' : undefined}
  data-title={title}
>
  <span class="corner-b" aria-hidden="true"></span>
  <img class="video__poster" src={still} alt="" width={ratio === '9x16' ? 720 : 1280} height={ratio === '9x16' ? 1280 : 720} loading="lazy" decoding="async" />
  {
    hasVideo ? (
      <button type="button" class="video__play" aria-label={`Play ${title}`}>
        <span class="video__mark" aria-hidden="true" />
      </button>
    ) : (
      <span class="video__play video__play--static" aria-hidden="true">
        <span class="video__mark" />
      </span>
    )
  }
  {
    autoplayMuted && hasVideo && (
      <button type="button" class="video__unmute mono" hidden>
        Tap for sound
      </button>
    )
  }
</div>

<style>
  .video {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #0b0b0b;
    overflow: hidden;
    border-radius: var(--radius);
    box-shadow: inset 0 0 0 1px rgba(243, 239, 232, 0.12);
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .video--9x16 {
    aspect-ratio: 9 / 16;
  }
  .video__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.9;
    transform: scale(1.02);
    transition: transform 900ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .video:hover .video__poster {
    transform: scale(1.06);
  }
  .video :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video__play {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: rgba(11, 11, 11, 0.12);
    border: 0;
    padding: 0;
    cursor: pointer;
    color: #f3efe8;
  }
  .video__play--static {
    cursor: default;
  }
  .video__mark {
    width: 72px;
    height: 72px;
    border: 1px solid rgba(243, 239, 232, 0.6);
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(11, 11, 11, 0.45);
    backdrop-filter: blur(6px);
    transition: border-color 220ms ease, background-color 220ms ease, transform 220ms ease;
  }
  .video__mark::after {
    content: '';
    display: block;
    width: 0;
    height: 0;
    margin-left: 4px;
    border-style: solid;
    border-width: 10px 0 10px 17px;
    border-color: transparent transparent transparent #f3efe8;
  }
  html.fine.motion .video__mark {
    opacity: 0;
  }
  .video:hover .video__mark,
  .video__play:focus-visible .video__mark {
    border-color: var(--orange);
    background: var(--orange);
    transform: scale(1.06);
  }
  .video:hover .video__mark::after,
  .video__play:focus-visible .video__mark::after {
    border-left-color: #0b0b0b;
  }
  .video:not(.video--empty):hover {
    transform: translateY(-3px);
  }
  .video__unmute {
    position: absolute;
    left: 16px;
    bottom: 16px;
    z-index: 2;
    min-height: 40px;
    padding: 0 16px;
    color: #0b0b0b;
    background: var(--orange);
    border: 0;
    border-radius: var(--radius);
    cursor: pointer;
  }
  .video--playing .video__poster,
  .video--playing .video__play,
  .video--playing .corner-b,
  .video--playing::before,
  .video--playing::after {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .video,
    .video__mark,
    .video__poster {
      transition: none;
    }
    .video:not(.video--empty):hover {
      transform: none;
    }
  }
</style>
