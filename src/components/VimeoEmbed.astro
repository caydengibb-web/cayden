---
/** Lazy Vimeo player. Still and play mark; iframe added on click or for load="now". */
import type { Ratio } from '../data/site';

interface Props {
  vimeoId: string;
  ratio?: Ratio;
  poster?: string;
  title: string;
  load?: 'click' | 'now';
  autoplayMuted?: boolean;
  class?: string;
}

const { vimeoId, ratio = '16x9', poster, title, load = 'click', autoplayMuted = false, class: className = '' } = Astro.props;
const still = poster ?? (ratio === '9x16' ? '/img/still-9x16.jpg' : '/img/still-16x9.jpg');
const hasVideo = vimeoId.trim().length > 0;
---

<div
  class:list={['video', `video--${ratio}`, className, { 'video--empty': !hasVideo }]}
  data-video
  data-cursor="Play"
  data-vimeo-id={hasVideo ? vimeoId : undefined}
  data-load={load}
  data-autoplay-muted={autoplayMuted ? '1' : undefined}
  data-title={title}
>
  <img class="video__poster" src={still} alt="" width={ratio === '9x16' ? 720 : 1280} height={ratio === '9x16' ? 1280 : 720} loading="lazy" decoding="async" />
  {
    hasVideo ? (
      <button type="button" class="video__play" aria-label={`Play ${title}`}>
        <span class="video__mark" aria-hidden="true" />
      </button>
    ) : (
      <span class="video__play video__play--static" aria-hidden="true">
        <span class="video__mark" />
      </span>
    )
  }
  {
    autoplayMuted && hasVideo && (
      <button type="button" class="video__unmute mono" hidden>
        Tap for sound
      </button>
    )
  }
</div>

<style>
  .video {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--stone);
    overflow: hidden;
  }
  .video--9x16 {
    aspect-ratio: 9 / 16;
  }
  .video__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    transition: transform 900ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .video:hover .video__poster {
    transform: scale(1.06);
  }
  .video :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video__play {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: var(--bone);
  }
  .video__play--static {
    cursor: default;
  }
  .video__mark {
    width: 64px;
    height: 64px;
    border: 1px solid rgba(244, 242, 237, 0.7);
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(17, 17, 16, 0.35);
    transition: border-color 220ms ease, background-color 220ms ease, transform 220ms ease;
  }
  .video__mark::after {
    content: '';
    display: block;
    width: 0;
    height: 0;
    margin-left: 4px;
    border-style: solid;
    border-width: 9px 0 9px 15px;
    border-color: transparent transparent transparent var(--bone);
  }
  html.fine.motion .video__mark {
    opacity: 0;
  }
  .video:hover .video__mark,
  .video__play:focus-visible .video__mark {
    border-color: var(--orange);
    background: var(--orange);
  }
  .video:hover .video__mark::after,
  .video__play:focus-visible .video__mark::after {
    border-left-color: var(--ink);
  }
  .video__unmute {
    position: absolute;
    left: 16px;
    bottom: 16px;
    z-index: 2;
    min-height: 40px;
    padding: 0 16px;
    color: var(--ink);
    background: var(--orange);
    border: 0;
    cursor: pointer;
  }
  .video--playing .video__poster,
  .video--playing .video__play {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .video__mark,
    .video__poster {
      transition: none;
    }
  }
</style>
