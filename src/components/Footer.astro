---
import { site } from '../data/site';

interface Props {
  minimal?: boolean;
}
const { minimal = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    {
      minimal ? (
        <p class="footer__copy mono muted center">
          &copy; {year} {site.name}. {site.city}.
        </p>
      ) : (
        <div class="footer__row mono">
          <p>
            {site.name}. {site.city}.
          </p>
          <ul class="footer__links">
            <li>
              <a href={`mailto:${site.links.email}`}>Email</a>
            </li>
            <li>
              <a href={site.links.linkedin} rel="noopener" target="_blank">
                LinkedIn
              </a>
            </li>
            <li>
              <a href={site.links.instagram} rel="noopener" target="_blank">
                Instagram
              </a>
            </li>
          </ul>
        </div>
      )
    }
  </div>
  {
    !minimal && (
      <div class="footer__mark" aria-hidden="true">
        <span>{site.name}</span>
      </div>
    )
  }
</footer>

<style>
  .footer {
    position: relative;
    padding: 48px 0 0;
    overflow: hidden;
  }
  .footer__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px 40px;
    align-items: baseline;
    padding-bottom: 24px;
    color: var(--muted);
  }
  .footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 28px;
  }
  .footer__links a:hover {
    color: var(--ink);
  }
  .footer__copy {
    padding-bottom: 40px;
  }
  .footer__mark {
    display: flex;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 15.4vw;
    letter-spacing: -0.06em;
    line-height: 0.78;
    white-space: nowrap;
    color: var(--ink);
    margin-top: 16px;
    transform: translateY(0.16em);
  }
</style>
