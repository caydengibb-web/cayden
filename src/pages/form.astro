---
/**
 * /form. A private daily weigh-in page for your phone.
 *
 * Not linked from the site and kept out of search. Everything typed here
 * stays in the phone's browser storage. Nothing is sent anywhere. Add it
 * to the Home Screen and it opens full screen like an app (manifest:
 * /form.webmanifest, offline cache: /form-sw.js).
 *
 * The page is self-contained on purpose: one file with plain CSS and JS,
 * so it can be copied anywhere as a single HTML document.
 */
---

<!doctype html>
<html lang="en-CA" data-look="noir">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Form</title>
    <meta name="description" content="A daily weigh-in." />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/form.webmanifest" />
    <link rel="apple-touch-icon" href="/form-icon-180.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Form" />
    <link rel="preload" href="/fonts/inter-tight-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif-latin-400-italic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Pick the saved look before first paint so the page never flashes. -->
    <script is:inline>
      (function () {
        try {
          var s = JSON.parse(localStorage.getItem('form.v1') || '{}');
          if (s.look === 'bone') document.documentElement.setAttribute('data-look', 'bone');
        } catch (e) {}
      })();
    </script>

    <style is:inline>
      /* FONTS (self-hosted) */
      @font-face {
        font-family: 'Inter Tight';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/inter-tight-latin-400-normal.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Inter Tight';
        font-style: normal;
        font-weight: 500;
        font-display: swap;
        src: url('/fonts/inter-tight-latin-500-normal.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Inter Tight';
        font-style: normal;
        font-weight: 800;
        font-display: swap;
        src: url('/fonts/inter-tight-latin-800-normal.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Instrument Serif';
        font-style: italic;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/instrument-serif-latin-400-italic.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Instrument Serif';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/instrument-serif-latin-400-normal.woff2') format('woff2');
      }
      @font-face {
        font-family: 'JetBrains Mono';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/jetbrains-mono-latin-400-normal.woff2') format('woff2');
      }
      /* /FONTS */

      /* ------------------------------------------------------------
         Tokens. Noir is the default: ink ground, bone type, no colour.
         Bone is the same page printed on paper.
         ------------------------------------------------------------ */
      :root {
        --ink: #0a0a0a;
        --carbon: #141413;
        --smoke: #262524;
        --ash: #8d8a83;
        --bone: #ece7dd;

        --bg: var(--ink);
        --bg-rgb: 10, 10, 10;
        --surface: var(--carbon);
        --text: var(--bone);
        --text-rgb: 236, 231, 221;
        --muted: var(--ash);
        --rule: rgba(236, 231, 221, 0.14);
        --track: var(--smoke);
        --fill: var(--bone);
        --on-fill: var(--ink);
        --grain: 0.07;

        --sans: 'Inter Tight', 'Helvetica Neue', Helvetica, Arial, sans-serif;
        --serif: 'Instrument Serif', Georgia, 'Times New Roman', serif;
        --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;

        --gutter: 20px;
        --max: 480px;
        --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
        color-scheme: dark;
      }
      html[data-look='bone'] {
        --bg: #f1ede4;
        --bg-rgb: 241, 237, 228;
        --surface: #e7e2d8;
        --text: #111110;
        --text-rgb: 17, 17, 16;
        --muted: #6a665f;
        --rule: rgba(17, 17, 16, 0.14);
        --track: #d8d2c6;
        --fill: #111110;
        --on-fill: #f1ede4;
        --grain: 0.05;
        color-scheme: light;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      [hidden] {
        display: none !important;
      }
      html {
        background: var(--bg);
        color: var(--text);
        font-family: var(--sans);
        font-size: 16px;
        line-height: 1.45;
        -webkit-text-size-adjust: 100%;
        -webkit-font-smoothing: antialiased;
        -webkit-tap-highlight-color: transparent;
      }
      body {
        margin: 0;
        min-height: 100svh;
        background: var(--bg);
        color: var(--text);
        overflow-x: hidden;
      }
      body.locked {
        overflow: hidden;
      }
      /* Film grain over everything. Cheap: one tiled SVG noise texture. */
      body::after {
        content: '';
        position: fixed;
        inset: 0;
        z-index: 60;
        pointer-events: none;
        opacity: var(--grain);
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.5 0 0 0 0 0.5 0 0 0 0 0.5 0 0 0 1 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
        background-size: 180px 180px;
        mix-blend-mode: overlay;
      }
      img {
        max-width: 100%;
        display: block;
      }
      button,
      input,
      textarea,
      select {
        font: inherit;
        color: inherit;
      }
      button {
        background: none;
        border: 0;
        padding: 0;
        cursor: pointer;
        touch-action: manipulation;
      }
      :focus-visible {
        outline: 2px solid var(--text);
        outline-offset: 3px;
      }
      p,
      h1,
      h2,
      h3,
      ol,
      ul {
        margin: 0;
      }
      ol,
      ul {
        padding: 0;
        list-style: none;
      }

      .mono {
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        line-height: 1.4;
      }
      .serif {
        font-family: var(--serif);
        font-style: italic;
        font-weight: 400;
        letter-spacing: -0.01em;
      }
      .muted {
        color: var(--muted);
      }

      /* ------------------------------------------------------------
         Page frame
         ------------------------------------------------------------ */
      .app {
        max-width: var(--max);
        margin: 0 auto;
        min-height: 100svh;
        position: relative;
      }
      @media (min-width: 560px) {
        .app {
          border-left: 1px solid var(--rule);
          border-right: 1px solid var(--rule);
        }
      }

      /* ------------------------------------------------------------
         Cover. The poster at the top: today's reference image (from the
         board) behind the number, or a typographic cover when there is
         no image yet.
         ------------------------------------------------------------ */
      .cover {
        position: relative;
        min-height: 72svh;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: calc(14px + env(safe-area-inset-top)) var(--gutter) 22px;
        overflow: hidden;
        isolation: isolate;
      }
      .cover__media {
        position: absolute;
        inset: 0;
        z-index: -2;
        background: var(--bg);
      }
      .cover__media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(0.35) contrast(1.05) brightness(0.92);
      }
      html[data-look='bone'] .cover__media img {
        filter: grayscale(0.35) contrast(1.02) brightness(1.02);
      }
      .cover__scrim {
        position: absolute;
        inset: 0;
        z-index: -1;
        background: linear-gradient(
          to bottom,
          rgba(var(--bg-rgb), 0.78) 0%,
          rgba(var(--bg-rgb), 0.3) 18%,
          rgba(var(--bg-rgb), 0.18) 40%,
          rgba(var(--bg-rgb), 0.6) 58%,
          rgba(var(--bg-rgb), 0.94) 78%,
          rgba(var(--bg-rgb), 1) 100%
        );
      }
      .cover.has-photo .cover__top .mono {
        color: var(--text);
      }
      .cover:not(.has-photo) .cover__scrim {
        display: none;
      }
      /* Watermark for the typographic cover: the day count, faint and huge. */
      .cover__mark {
        position: absolute;
        right: -0.04em;
        top: calc(8px + env(safe-area-inset-top));
        z-index: -1;
        font-family: var(--serif);
        font-style: italic;
        font-size: 300px;
        line-height: 0.8;
        letter-spacing: -0.06em;
        color: transparent;
        -webkit-text-stroke: 1px rgba(var(--text-rgb), 0.16);
        user-select: none;
        pointer-events: none;
      }
      .cover.has-photo .cover__mark {
        display: none;
      }
      .cover__top {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
      }
      .brand {
        font-family: var(--serif);
        font-style: italic;
        font-size: 30px;
        line-height: 1;
        letter-spacing: -0.02em;
      }
      .brand::after {
        content: '.';
      }
      .cover__meta {
        display: flex;
        align-items: center;
        gap: 14px;
      }
      .icon-btn {
        width: 40px;
        height: 40px;
        margin: -8px -8px -8px 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--text);
      }
      .icon-btn svg {
        width: 20px;
        height: 20px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.5;
        stroke-linecap: round;
      }
      .cover__body {
        display: grid;
        gap: 22px;
        padding-top: 48px;
      }
      .daily {
        font-family: var(--serif);
        font-style: italic;
        font-size: 33px;
        line-height: 1.06;
        letter-spacing: -0.015em;
        max-width: 15ch;
        text-wrap: balance;
      }
      .daily--intro {
        font-size: 44px;
      }
      .daily-sub {
        margin-top: 10px;
        max-width: 34ch;
        color: var(--muted);
        font-size: 15px;
        line-height: 1.45;
      }
      .hero {
        display: flex;
        align-items: baseline;
        gap: 10px;
      }
      .hero__num {
        font-family: var(--sans);
        font-weight: 500;
        font-size: 118px;
        line-height: 0.86;
        letter-spacing: -0.055em;
        font-variant-numeric: proportional-nums;
        margin-left: -0.04em;
      }
      .hero__unit {
        font-family: var(--mono);
        font-size: 12px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .hero__sub {
        margin-top: 12px;
        color: var(--muted);
      }
      .hero__sub b {
        color: var(--text);
        font-weight: 400;
      }

      .meter {
        display: grid;
        gap: 10px;
      }
      .meter__track {
        height: 2px;
        background: var(--track);
        position: relative;
      }
      .meter__fill {
        position: absolute;
        left: 0;
        top: -1px;
        height: 4px;
        width: 0%;
        background: var(--fill);
        transition: width 900ms var(--ease);
      }
      .meter__ends {
        display: flex;
        justify-content: space-between;
        color: var(--muted);
      }
      .meter__ends b {
        color: var(--text);
        font-weight: 400;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 56px;
        padding: 0 22px;
        font-family: var(--mono);
        font-size: 12px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        border: 1px solid var(--text);
        color: var(--text);
        transition:
          transform 140ms var(--ease),
          background 140ms var(--ease),
          color 140ms var(--ease);
      }
      .btn:active {
        transform: scale(0.985);
      }
      .btn--primary {
        background: var(--fill);
        color: var(--on-fill);
        border-color: var(--fill);
        width: 100%;
      }
      .btn--ghost {
        min-height: 36px;
        padding: 0 14px;
        border-color: var(--rule);
      }
      .btn--danger {
        border-color: var(--rule);
        color: var(--muted);
      }
      .btn--block {
        width: 100%;
      }
      .link {
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
        text-decoration: underline;
        text-underline-offset: 4px;
      }

      /* ------------------------------------------------------------
         Sections
         ------------------------------------------------------------ */
      .sec {
        padding: 30px var(--gutter);
        border-top: 1px solid var(--rule);
      }
      .sec__head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 18px;
      }
      .sec__title {
        font-family: var(--serif);
        font-style: italic;
        font-weight: 400;
        font-size: 28px;
        line-height: 1;
        letter-spacing: -0.01em;
      }
      .seg {
        display: inline-flex;
        border: 1px solid var(--rule);
      }
      .seg button {
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        padding: 8px 10px;
        color: var(--muted);
        min-width: 40px;
      }
      .seg button.on {
        background: var(--fill);
        color: var(--on-fill);
      }
      .seg--wide button {
        flex: 1;
        padding: 12px 10px;
      }

      /* Banners */
      .banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 12px var(--gutter);
        border-top: 1px solid var(--rule);
        color: var(--muted);
      }
      .banner button {
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--text);
        text-decoration: underline;
        text-underline-offset: 4px;
        white-space: nowrap;
      }
      .banner--hint {
        text-transform: none;
        letter-spacing: 0;
        font-family: var(--sans);
        font-size: 14px;
      }
      .banner--hint b {
        font-weight: 500;
        color: var(--text);
      }

      /* ------------------------------------------------------------
         Chart
         ------------------------------------------------------------ */
      .chart {
        position: relative;
        touch-action: pan-y;
        user-select: none;
        -webkit-user-select: none;
      }
      .chart svg {
        display: block;
        width: 100%;
        height: 232px;
        overflow: visible;
      }
      .chart .grid line {
        stroke: var(--rule);
        stroke-width: 1;
      }
      .chart .goal line {
        stroke: var(--muted);
        stroke-width: 1;
        stroke-dasharray: 3 4;
      }
      .chart .daily-line {
        fill: none;
        stroke: var(--muted);
        stroke-width: 1.25;
        stroke-linejoin: round;
        stroke-linecap: round;
        opacity: 0.85;
      }
      .chart .daily-dot {
        fill: var(--muted);
        stroke: var(--bg);
        stroke-width: 2;
      }
      .chart .trend-line {
        fill: none;
        stroke: var(--text);
        stroke-width: 2;
        stroke-linejoin: round;
        stroke-linecap: round;
      }
      .chart .trend-area {
        fill: var(--text);
        opacity: 0.07;
      }
      .chart .end-dot {
        fill: var(--text);
        stroke: var(--bg);
        stroke-width: 2;
      }
      .chart text {
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.06em;
        fill: var(--muted);
      }
      .chart text.strong {
        fill: var(--text);
      }
      .chart .cross line {
        stroke: var(--text);
        stroke-width: 1;
        opacity: 0.6;
      }
      .chart .cross circle {
        fill: var(--text);
        stroke: var(--bg);
        stroke-width: 2;
      }
      .tip {
        position: absolute;
        top: 0;
        transform: translateX(-50%);
        background: var(--fill);
        color: var(--on-fill);
        padding: 8px 10px;
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        white-space: nowrap;
        pointer-events: none;
        line-height: 1.5;
      }
      .tip b {
        font-family: var(--sans);
        font-weight: 500;
        font-size: 14px;
        letter-spacing: -0.01em;
        text-transform: none;
      }
      .chart__empty {
        min-height: 160px;
        display: grid;
        place-items: center;
        text-align: center;
        color: var(--muted);
        font-family: var(--serif);
        font-style: italic;
        font-size: 22px;
        border: 1px solid var(--rule);
        padding: 20px;
      }
      .legend {
        display: flex;
        gap: 18px;
        margin-top: 14px;
        color: var(--muted);
      }
      .legend span {
        display: inline-flex;
        align-items: center;
        gap: 8px;
      }
      .legend i {
        display: inline-block;
        width: 18px;
        height: 0;
        border-top: 2px solid var(--text);
      }
      .legend i.thin {
        border-top-width: 1px;
        border-top-color: var(--muted);
      }
      .legend i.dash {
        border-top-width: 1px;
        border-top-style: dashed;
        border-top-color: var(--muted);
      }

      /* ------------------------------------------------------------
         Stats
         ------------------------------------------------------------ */
      .stats {
        display: grid;
        grid-template-columns: 1fr 1fr;
        border-top: 1px solid var(--rule);
      }
      .stat {
        padding: 22px var(--gutter);
        display: grid;
        gap: 8px;
        border-bottom: 1px solid var(--rule);
      }
      .stat:nth-child(odd) {
        border-right: 1px solid var(--rule);
      }
      .stat__label {
        color: var(--muted);
      }
      .stat__val {
        font-family: var(--sans);
        font-weight: 500;
        font-size: 34px;
        line-height: 1;
        letter-spacing: -0.035em;
      }
      .stat__val small {
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
        margin-left: 6px;
      }
      .insight {
        padding: 18px var(--gutter);
        font-family: var(--serif);
        font-style: italic;
        font-size: 20px;
        line-height: 1.25;
        color: var(--text);
        border-bottom: 1px solid var(--rule);
      }

      /* ------------------------------------------------------------
         Board. A masonry of the images you save, plus a few typographic
         cards in the same voice.
         ------------------------------------------------------------ */
      .board__hint {
        color: var(--muted);
        font-size: 14px;
        line-height: 1.5;
        max-width: 40ch;
        margin: -6px 0 18px;
      }
      .masonry {
        columns: 2;
        column-gap: 8px;
      }
      .pin {
        break-inside: avoid;
        margin: 0 0 8px;
        position: relative;
        background: var(--surface);
        overflow: hidden;
      }
      .pin button.pin__hit {
        display: block;
        width: 100%;
      }
      .pin img {
        width: 100%;
        height: auto;
        display: block;
        filter: grayscale(0.3) contrast(1.03);
        transition: filter 300ms var(--ease);
      }
      html.colour .pin img,
      html.colour .cover__media img {
        filter: none;
      }
      .card {
        padding: 22px 18px;
        min-height: 150px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        border: 1px solid var(--rule);
      }
      .card--serif {
        font-family: var(--serif);
        font-style: italic;
        font-size: 27px;
        line-height: 1.02;
        letter-spacing: -0.01em;
        text-wrap: balance;
      }
      .card--mono {
        font-family: var(--mono);
        font-size: 12px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        line-height: 1.7;
      }
      .card--sans {
        font-family: var(--sans);
        font-weight: 800;
        font-size: 34px;
        line-height: 0.92;
        letter-spacing: -0.045em;
        text-transform: uppercase;
      }
      .card--inverse {
        background: var(--fill);
        color: var(--on-fill);
        border-color: var(--fill);
      }
      .card--tall {
        min-height: 220px;
      }
      .card--live .live__n {
        font-family: var(--sans);
        font-weight: 500;
        font-size: 56px;
        line-height: 0.9;
        letter-spacing: -0.05em;
      }
      .card--live .live__l {
        margin-top: 14px;
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        opacity: 0.75;
      }
      .pin--add {
        border: 1px dashed var(--rule);
        min-height: 120px;
        display: grid;
        place-items: center;
        color: var(--muted);
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      .pin--add button {
        width: 100%;
        min-height: 120px;
        color: inherit;
      }

      /* ------------------------------------------------------------
         History
         ------------------------------------------------------------ */
      .hist li {
        border-top: 1px solid var(--rule);
      }
      .hist li:last-child {
        border-bottom: 1px solid var(--rule);
      }
      .hist button {
        width: 100%;
        display: grid;
        grid-template-columns: 1fr auto auto;
        align-items: baseline;
        gap: 14px;
        padding: 14px 0;
        text-align: left;
      }
      .hist .h-date {
        color: var(--muted);
      }
      .hist .h-val {
        font-family: var(--sans);
        font-weight: 500;
        font-size: 20px;
        letter-spacing: -0.02em;
        font-variant-numeric: tabular-nums;
      }
      .hist .h-delta {
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.06em;
        color: var(--muted);
        min-width: 44px;
        text-align: right;
        font-variant-numeric: tabular-nums;
      }
      .hist .h-delta.best {
        color: var(--text);
      }
      .hist__more {
        margin-top: 14px;
      }
      .empty {
        color: var(--muted);
        font-family: var(--serif);
        font-style: italic;
        font-size: 20px;
      }

      .foot {
        padding: 30px var(--gutter) calc(30px + env(safe-area-inset-bottom));
        color: var(--muted);
        display: grid;
        gap: 8px;
      }

      /* ------------------------------------------------------------
         Sheets (bottom panels), viewer, toast
         ------------------------------------------------------------ */
      .sheet {
        position: fixed;
        inset: 0;
        z-index: 40;
        display: flex;
        align-items: flex-end;
        justify-content: center;
      }
      .sheet__back {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.62);
        opacity: 0;
        transition: opacity 240ms var(--ease);
      }
      .sheet__panel {
        position: relative;
        width: 100%;
        max-width: var(--max);
        max-height: 92svh;
        overflow: auto;
        background: var(--bg);
        border-top: 1px solid var(--rule);
        padding: 18px var(--gutter) calc(22px + env(safe-area-inset-bottom));
        transform: translateY(102%);
        transition: transform 300ms var(--ease);
      }
      .sheet.is-open .sheet__back {
        opacity: 1;
      }
      .sheet.is-open .sheet__panel {
        transform: translateY(0);
      }
      .sheet__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
      }
      .sheet__title {
        font-family: var(--serif);
        font-style: italic;
        font-weight: 400;
        font-size: 28px;
        line-height: 1;
      }
      .field {
        display: grid;
        gap: 8px;
        padding: 16px 0;
        border-top: 1px solid var(--rule);
      }
      .field > label,
      .field__label {
        color: var(--muted);
      }
      .field input[type='text'],
      .field input[type='date'],
      .field textarea {
        width: 100%;
        background: transparent;
        border: 0;
        border-bottom: 1px solid var(--rule);
        padding: 8px 0;
        font-size: 18px;
        min-height: 44px;
        border-radius: 0;
        -webkit-appearance: none;
        appearance: none;
      }
      .field input::placeholder {
        color: var(--muted);
        opacity: 1;
      }
      .field textarea {
        font-family: var(--mono);
        font-size: 12px;
        min-height: 110px;
        resize: vertical;
      }
      .row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }
      .row--split {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
      }
      .switch {
        position: relative;
        width: 46px;
        height: 26px;
        flex: none;
        border: 1px solid var(--text);
        background: transparent;
      }
      .switch::after {
        content: '';
        position: absolute;
        top: 3px;
        left: 3px;
        width: 18px;
        height: 18px;
        background: var(--text);
        transition: transform 180ms var(--ease);
      }
      .switch[aria-checked='false'] {
        border-color: var(--muted);
      }
      .switch[aria-checked='false']::after {
        background: var(--muted);
        transform: translateX(0);
      }
      .switch[aria-checked='true']::after {
        transform: translateX(20px);
      }

      /* Weigh-in entry */
      .weigh {
        display: grid;
        grid-template-columns: 52px 1fr 52px;
        align-items: center;
        gap: 6px;
        padding: 14px 0 6px;
      }
      .weigh input {
        width: 100%;
        background: transparent;
        border: 0;
        border-bottom: 1px solid var(--rule);
        text-align: center;
        font-family: var(--sans);
        font-weight: 500;
        font-size: 64px;
        letter-spacing: -0.05em;
        line-height: 1.1;
        padding: 0 0 4px;
        border-radius: 0;
        -webkit-appearance: none;
        appearance: none;
      }
      .weigh input::placeholder {
        color: var(--muted);
        opacity: 0.5;
      }
      .step {
        width: 52px;
        height: 52px;
        border: 1px solid var(--rule);
        font-family: var(--sans);
        font-weight: 400;
        font-size: 28px;
        line-height: 1;
      }
      .weigh__unit {
        text-align: center;
        color: var(--muted);
        margin-bottom: 4px;
      }
      .sheet__actions {
        display: grid;
        gap: 10px;
        margin-top: 18px;
      }

      /* Viewer */
      .viewer {
        position: fixed;
        inset: 0;
        z-index: 50;
        background: rgba(var(--bg-rgb), 0.97);
        display: grid;
        grid-template-rows: auto 1fr auto;
      }
      .viewer__bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: calc(12px + env(safe-area-inset-top)) var(--gutter) 12px;
      }
      .viewer img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
      .viewer__foot {
        padding: 12px var(--gutter) calc(18px + env(safe-area-inset-bottom));
        display: flex;
        justify-content: center;
      }

      /* Toast */
      .toast {
        position: fixed;
        left: 50%;
        bottom: calc(24px + env(safe-area-inset-bottom));
        transform: translate(-50%, 8px);
        z-index: 70;
        background: var(--fill);
        color: var(--on-fill);
        padding: 12px 18px;
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        opacity: 0;
        transition:
          opacity 200ms var(--ease),
          transform 200ms var(--ease);
        pointer-events: none;
        white-space: nowrap;
      }
      .toast.show {
        opacity: 1;
        transform: translate(-50%, 0);
      }

      /* Entrance */
      .rise {
        animation: rise 700ms var(--ease) both;
      }
      .rise:nth-child(2) {
        animation-delay: 60ms;
      }
      .rise:nth-child(3) {
        animation-delay: 120ms;
      }
      .rise:nth-child(4) {
        animation-delay: 180ms;
      }
      .rise:nth-child(5) {
        animation-delay: 240ms;
      }
      @keyframes rise {
        from {
          opacity: 0.001;
          transform: translateY(10px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
      .pop {
        animation: pop 420ms var(--ease);
      }
      @keyframes pop {
        0% {
          transform: scale(0.96);
        }
        60% {
          transform: scale(1.015);
        }
        100% {
          transform: none;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation: none !important;
          transition: none !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="app" id="app">
      <!-- Cover -->
      <header class="cover" id="cover">
        <div class="cover__media" id="coverMedia" aria-hidden="true"></div>
        <div class="cover__scrim" aria-hidden="true"></div>
        <div class="cover__mark" id="coverMark" aria-hidden="true">01</div>

        <div class="cover__top rise">
          <h1 class="brand">Form</h1>
          <div class="cover__meta">
            <span class="mono muted" id="dateLine"></span>
            <button class="icon-btn" id="openSettings" aria-label="Settings">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <line x1="4" y1="7" x2="20" y2="7"></line>
                <line x1="4" y1="12" x2="20" y2="12"></line>
                <line x1="4" y1="17" x2="20" y2="17"></line>
              </svg>
            </button>
          </div>
        </div>

        <div class="cover__body">
          <div class="rise">
            <p class="daily" id="dailyLine">Start with today's number.</p>
            <p class="daily-sub" id="dailySub" hidden></p>
          </div>

          <div class="rise" id="heroWrap">
            <div class="hero">
              <span class="hero__num" id="heroNum">0</span>
              <span class="hero__unit" id="heroUnit">lb</span>
            </div>
            <p class="hero__sub mono" id="heroSub"></p>
          </div>

          <div class="meter rise" id="meter" hidden>
            <div class="meter__track"><div class="meter__fill" id="meterFill"></div></div>
            <div class="meter__ends mono">
              <span id="meterStart"></span>
              <span><b id="meterPct"></b></span>
              <span id="meterGoal"></span>
            </div>
          </div>

          <div class="rise">
            <button class="btn btn--primary" id="logBtn">Log today's weight</button>
            <p class="mono muted" id="sampleLink" style="margin-top: 14px" hidden>
              <button class="link" id="sampleBtn">Or see it with sample data</button>
            </p>
          </div>
        </div>
      </header>

      <div class="banner mono" id="sampleBanner" hidden>
        <span>Sample data. Yours will replace it.</span>
        <button id="clearSample">Clear</button>
      </div>

      <div class="banner banner--hint" id="installHint" hidden>
        <span>To use this as an app: tap <b>Share</b>, then <b>Add to Home Screen</b>.</span>
        <button id="dismissHint">Got it</button>
      </div>

      <!-- Trend -->
      <section class="sec" id="chartSec">
        <div class="sec__head">
          <h2 class="sec__title">Trend</h2>
          <div class="seg" role="group" aria-label="Range" id="rangeSeg">
            <button data-range="30" class="on">30d</button>
            <button data-range="90">90d</button>
            <button data-range="365">1y</button>
            <button data-range="all">All</button>
          </div>
        </div>
        <div class="chart" id="chart">
          <svg id="chartSvg" role="img" aria-label="Weight over time"></svg>
          <div class="tip" id="tip" hidden></div>
        </div>
        <div class="chart__empty" id="chartEmpty" hidden>Two weigh-ins draw the first line.</div>
        <div class="legend mono" id="legend">
          <span><i class="thin"></i>daily</span>
          <span><i></i>trend</span>
          <span id="legendGoal"><i class="dash"></i>goal</span>
        </div>
      </section>

      <!-- Stats -->
      <section class="stats" aria-label="Progress">
        <div class="stat">
          <span class="stat__label mono">Streak</span>
          <span class="stat__val" id="stStreak">0<small>days</small></span>
        </div>
        <div class="stat">
          <span class="stat__label mono">Trend weight</span>
          <span class="stat__val" id="stTrend">—</span>
        </div>
        <div class="stat">
          <span class="stat__label mono">Per week</span>
          <span class="stat__val" id="stRate">—</span>
        </div>
        <div class="stat">
          <span class="stat__label mono">Goal date</span>
          <span class="stat__val" id="stEta">—</span>
        </div>
      </section>
      <p class="insight" id="insight" hidden></p>

      <!-- Board -->
      <section class="sec" id="boardSec">
        <div class="sec__head">
          <h2 class="sec__title">Board</h2>
          <button class="btn btn--ghost" id="addPin">+ Add</button>
        </div>
        <p class="board__hint" id="boardHint">
          The physiques you are working toward. Save pins from Pinterest to your camera roll, then add them here.
        </p>
        <div class="masonry" id="masonry"></div>
      </section>

      <!-- History -->
      <section class="sec" id="histSec">
        <div class="sec__head">
          <h2 class="sec__title">Log</h2>
          <span class="mono muted" id="histCount"></span>
        </div>
        <ol class="hist" id="hist"></ol>
        <p class="empty" id="histEmpty">Nothing logged yet.</p>
        <p class="hist__more" id="histMoreWrap" hidden>
          <button class="link" id="histMore">Show everything</button>
        </p>
      </section>

      <footer class="foot mono">
        <span>Everything stays on this device.</span>
        <span>Back it up from the menu.</span>
      </footer>
    </div>

    <!-- Weigh-in sheet -->
    <div class="sheet" id="logSheet" hidden role="dialog" aria-modal="true" aria-labelledby="logTitle">
      <div class="sheet__back" data-close></div>
      <div class="sheet__panel">
        <div class="sheet__head">
          <h2 class="sheet__title" id="logTitle">Today</h2>
          <button class="icon-btn" data-close aria-label="Close">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <line x1="6" y1="6" x2="18" y2="18"></line>
              <line x1="18" y1="6" x2="6" y2="18"></line>
            </svg>
          </button>
        </div>

        <div class="weigh">
          <button class="step" id="stepDown" aria-label="Down 0.1">−</button>
          <input id="weightInput" type="text" inputmode="decimal" autocomplete="off" placeholder="0.0" aria-label="Weight" />
          <button class="step" id="stepUp" aria-label="Up 0.1">+</button>
        </div>
        <p class="weigh__unit mono" id="weighUnit">lb</p>

        <div class="field">
          <label for="dateInput">Date</label>
          <input id="dateInput" type="date" />
        </div>

        <div class="field" id="goalField" hidden>
          <label for="goalInputFirst">Goal weight</label>
          <input id="goalInputFirst" type="text" inputmode="decimal" placeholder="Where you are headed" />
        </div>

        <div class="sheet__actions">
          <button class="btn btn--primary" id="saveEntry">Save</button>
          <button class="btn btn--danger" id="deleteEntry" hidden>Remove this entry</button>
        </div>
      </div>
    </div>

    <!-- Add to board sheet -->
    <div class="sheet" id="pinSheet" hidden role="dialog" aria-modal="true" aria-labelledby="pinTitle">
      <div class="sheet__back" data-close></div>
      <div class="sheet__panel">
        <div class="sheet__head">
          <h2 class="sheet__title" id="pinTitle">Add to the board</h2>
          <button class="icon-btn" data-close aria-label="Close">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <line x1="6" y1="6" x2="18" y2="18"></line>
              <line x1="18" y1="6" x2="6" y2="18"></line>
            </svg>
          </button>
        </div>
        <div class="sheet__actions" style="margin-top: 0">
          <button class="btn btn--primary" id="pickPhotos">Choose from photos</button>
        </div>
        <div class="field" style="margin-top: 18px">
          <label for="urlInput">Or paste an image link</label>
          <input id="urlInput" type="text" inputmode="url" autocomplete="off" placeholder="https://i.pinimg.com/..." />
        </div>
        <div class="sheet__actions">
          <button class="btn" id="addUrl">Add link</button>
        </div>
      </div>
    </div>

    <!-- Settings sheet -->
    <div class="sheet" id="settingsSheet" hidden role="dialog" aria-modal="true" aria-labelledby="settingsTitle">
      <div class="sheet__back" data-close></div>
      <div class="sheet__panel">
        <div class="sheet__head">
          <h2 class="sheet__title" id="settingsTitle">Settings</h2>
          <button class="icon-btn" data-close aria-label="Close">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <line x1="6" y1="6" x2="18" y2="18"></line>
              <line x1="18" y1="6" x2="6" y2="18"></line>
            </svg>
          </button>
        </div>

        <div class="field">
          <span class="field__label mono">Units</span>
          <div class="seg seg--wide" role="group" aria-label="Units" id="unitSeg">
            <button data-unit="lb">lb</button>
            <button data-unit="kg">kg</button>
          </div>
        </div>

        <div class="field">
          <label for="goalInput" class="mono">Goal weight</label>
          <input id="goalInput" type="text" inputmode="decimal" placeholder="Not set" />
        </div>

        <div class="field">
          <label for="startInput" class="mono">Starting weight</label>
          <input id="startInput" type="text" inputmode="decimal" placeholder="Your first entry" />
        </div>

        <div class="field">
          <label for="nameInput" class="mono">Your name</label>
          <input id="nameInput" type="text" autocomplete="given-name" placeholder="Optional" />
        </div>

        <div class="field">
          <span class="field__label mono">Look</span>
          <div class="seg seg--wide" role="group" aria-label="Look" id="lookSeg">
            <button data-look="noir">Noir</button>
            <button data-look="bone">Bone</button>
          </div>
        </div>

        <div class="field">
          <div class="row">
            <span class="mono" id="lblMono">Monochrome photos</span>
            <button class="switch" role="switch" aria-checked="true" id="swMono" aria-labelledby="lblMono"></button>
          </div>
        </div>
        <div class="field">
          <div class="row">
            <span class="mono" id="lblCover">Board photo on the cover</span>
            <button class="switch" role="switch" aria-checked="true" id="swCover" aria-labelledby="lblCover"></button>
          </div>
        </div>
        <div class="field">
          <div class="row">
            <span class="mono" id="lblQuotes">Quote cards on the board</span>
            <button class="switch" role="switch" aria-checked="true" id="swQuotes" aria-labelledby="lblQuotes"></button>
          </div>
        </div>

        <div class="field">
          <span class="field__label mono">Backup</span>
          <div class="row--split">
            <button class="btn" id="exportBtn">Export</button>
            <button class="btn" id="importBtn">Import</button>
          </div>
          <div id="backupBox" hidden style="margin-top: 12px">
            <textarea id="backupText" aria-label="Backup text" spellcheck="false"></textarea>
            <div class="row--split" style="margin-top: 10px">
              <button class="btn" id="copyBackup">Copy</button>
              <button class="btn" id="restoreBackup">Restore</button>
            </div>
            <p class="mono muted" style="margin-top: 10px">Board photos are not included in the backup.</p>
          </div>
        </div>

        <div class="field">
          <button class="btn btn--danger btn--block" id="resetBtn">Erase everything</button>
        </div>
      </div>
    </div>

    <!-- Image viewer -->
    <div class="viewer" id="viewer" hidden role="dialog" aria-modal="true" aria-label="Image">
      <div class="viewer__bar">
        <span class="mono muted" id="viewerMeta"></span>
        <button class="icon-btn" id="viewerClose" aria-label="Close">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <line x1="6" y1="6" x2="18" y2="18"></line>
            <line x1="18" y1="6" x2="6" y2="18"></line>
          </svg>
        </button>
      </div>
      <img id="viewerImg" alt="" />
      <div class="viewer__foot">
        <button class="btn btn--danger" id="viewerRemove">Remove from board</button>
      </div>
    </div>

    <input type="file" id="fileInput" accept="image/*" multiple hidden />
    <div class="toast mono" id="toast" role="status" aria-live="polite"></div>

    <script is:inline>
      (function () {
        'use strict';

        /* ------------------------------------------------------------
           Helpers
           ------------------------------------------------------------ */
        var $ = function (s, r) { return (r || document).querySelector(s); };
        var $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };
        var KEY = 'form.v1';
        var KG_PER_LB = 0.45359237;
        var DAY = 86400000;
        var MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        var MONTHS_LONG = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
        var DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
