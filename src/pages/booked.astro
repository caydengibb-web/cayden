---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
---

<Base
  title="You're booked. Real Reach Content."
  description="Your call with Cayden is booked. Check your email for the details."
  path="/booked"
  noindex
  bodyClass="page-booked"
>
  <header class="top">
    <div class="wrap">
      <span class="wordmark"><span class="wordmark__dot" aria-hidden="true"></span>{site.name}</span>
    </div>
  </header>

  <main class="booked theme-dark">
    <div class="grain" aria-hidden="true"></div>
    <div class="wrap">
      <span class="label">Booked</span>
      <h1>You're <span class="serif accent">booked.</span></h1>
      <p class="lead lead--big measure booked__body">Check your email for the details. Cayden will see you then.</p>
    </div>
  </main>

  <Footer minimal />

  <style>
    .top {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      padding-top: 24px;
      color: var(--bone);
    }
    .wordmark {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-weight: 800;
      letter-spacing: -0.02em;
      font-size: 17px;
    }
    .wordmark__dot {
      width: 8px;
      height: 8px;
      background: var(--orange);
    }
    .booked {
      position: relative;
      min-height: 80svh;
      display: flex;
      align-items: center;
      padding: var(--section) 0;
      overflow: hidden;
    }
    .booked__body {
      margin-top: 32px;
    }
  </style>

  <script>
    import '../scripts/booked';
  </script>
</Base>
