---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Cursor from '../components/Cursor.astro';
import Footer from '../components/Footer.astro';
import Viewfinder from '../components/Viewfinder.astro';
import Services from '../components/Services.astro';
import WorkGallery from '../components/WorkGallery.astro';
import Testimonials from '../components/Testimonials.astro';
import Stats from '../components/Stats.astro';
import WhoFor from '../components/WhoFor.astro';
import { site, clientNamesSentence } from '../data/site';

const names = clientNamesSentence();
const trusted = names ? `Trusted by ${names} and other companies across Ontario.` : '';
const hero = site.videos.heroLoop;
---

<Base
  title="Real Reach Content. Video marketing for established companies in Sarnia, Ontario."
  description="Real Reach Content makes video for established companies that never built a marketing team. We film it, write it, post it, and run the ads. Sarnia, Ontario."
  path="/"
>
  <Fragment slot="fixed">
    <Nav />
    <Cursor />
  </Fragment>

  <section class="hero" data-hero>
    <div class="hero__frame" data-hero-frame>
      <video
        class="hero__video"
        data-hero-video
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={hero.poster}
        aria-hidden="true"
        tabindex="-1"
      >
        <source src={hero.webm} type="video/webm" />
        <source src={hero.mp4} type="video/mp4" />
      </video>
    </div>
    <div class="hero__vf" data-hero-vf>
      <Viewfinder clip="A001_C001" />
    </div>

    <h1 class="hero__h1">
      <span class="hero__title mono" data-hero-title>Your company is</span>
      <span class="hero__claim" data-hero-claim>bigger than it looks online.</span>
    </h1>

    <p class="hero__hint mono muted" data-hero-hint aria-hidden="true">Scroll</p>

    <div class="wrap hero__below">
      <p class="hero__sub" data-hero-below>
        Real Reach Content makes video for established companies that never built a marketing team.
        We film it, write it, post it, and run the ads. You show up on camera a few hours a month.
      </p>
      <div class="hero__cta" data-hero-below>
        <a href="/call" class="btn btn--primary btn--lg" data-magnetic data-cursor="Book">Book a call</a>
        {trusted && <p class="hero__trust mono muted">{trusted}</p>}
      </div>
    </div>
  </section>

  <main>
    <!-- 1. The problem: a statement, then the copy fills in as you read. -->
    <section class="section problem" id="problem">
      <div class="wrap">
        <span class="label">The problem</span>
        <h2 class="problem__h2" data-lines>Your marketing is someone's side job.</h2>
        <p class="lead--big problem__body" data-words>
          Maybe it's an intern. Maybe it's the office manager between everything else. There is no
          plan. Posts go out when someone remembers. The last photo of your shop was taken on a phone
          in bad light. Meanwhile you have a hundred employees and clients across the country. Anyone
          who looks you up would never know.
        </p>
      </div>
    </section>

    <!-- 2. What we do: one line of intent, then the menu. -->
    <section class="section what" id="what-we-do">
      <div class="wrap center">
        <span class="label">What we do</span>
        <h2 class="narrow" data-lines>We take over your marketing and content.</h2>
        <p class="lead narrow what__body" data-reveal>
          One team handles the whole thing. We come to you and film. We write what your leaders say
          on camera so it's true and sounds like them. We edit it, post it, and put money behind the
          pieces that bring in clients.
        </p>
        <Services />
      </div>
    </section>

    <!-- 3. Work: sideways. -->
    <WorkGallery />

    <!-- 4. Results: faces, then one big number. -->
    <section class="section results" id="results">
      <div class="wrap">
        <div class="center">
          <span class="label">Results</span>
          <h2 data-lines>What clients say.</h2>
        </div>
        <div class="results__grid">
          <Testimonials max={3} />
        </div>
        <Stats />
      </div>
    </section>

    <!-- 5. Sarnia: a poster. -->
    <section class="section local" id="local">
      <div class="local__meta mono muted wrap">
        <span>Sarnia, Ontario</span>
        <span>42.97° N, 82.40° W</span>
        <span>Now <span data-clock>0:00</span></span>
      </div>
      <h2 class="local__h2" data-lines>We're here.<br />We show up.</h2>
      <p class="lead--big narrow center local__body" data-reveal>
        We come to your shop, your yard, your office. We film your people where they work. Agencies
        you hire off the internet send a brief and hope for the best. We drive over.
      </p>
    </section>

    <!-- 6. Who this is for: quiet. -->
    <section class="section" id="who">
      <div class="wrap">
        <WhoFor />
      </div>
    </section>

    <!-- 7. Final call: one button. -->
    <section class="section final center" id="book">
      <div class="wrap">
        <h2 class="final__h2" data-lines>Book a call with Cayden.</h2>
        <p class="lead narrow final__body" data-reveal>
          Twenty minutes. We look at what you have now, tell you what we'd do, and if it fits you get
          a plan and a price. No slide deck.
        </p>
        <div data-reveal class="final__cta">
          <a href="/call" class="btn btn--primary btn--lg" data-magnetic data-cursor="Book">Book a call</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    import '../scripts/main';
  </script>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    height: 100svh;
    min-height: 620px;
    overflow: hidden;
  }
  .hero__frame {
    position: absolute;
    inset: 0;
    z-index: 0;
    clip-path: inset(11% 4% 34% 4%);
  }
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__vf {
    position: absolute;
    top: 11%;
    right: 4%;
    bottom: 34%;
    left: 4%;
    z-index: 2;
    pointer-events: none;
  }
  .hero__h1 {
    display: contents;
  }
  .hero__title {
    position: absolute;
    top: 19%;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    color: var(--ink);
    font-size: 12px;
    letter-spacing: 0.22em;
    white-space: nowrap;
  }
  .hero__claim {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    top: 69%;
    z-index: 3;
    display: block;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(38px, 6.6vw, 96px);
    letter-spacing: -0.045em;
    line-height: 0.96;
    max-width: var(--max);
    margin: 0 auto;
  }
  .hero__hint {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    margin: 0;
    opacity: 0;
  }
  .hero__below {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(28px, 5vh, 56px);
    z-index: 3;
    display: grid;
    gap: 20px;
  }
  @media (min-width: 900px) {
    .hero__below {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      align-items: end;
      gap: 48px;
    }
  }
  .hero__sub {
    max-width: 46ch;
    font-size: 16px;
    line-height: 1.5;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
  }
  @media (min-width: 900px) {
    .hero__cta {
      justify-content: flex-end;
    }
  }
  .hero__trust {
    max-width: 30ch;
  }
  /* Without motion the hero is simply open. */
  html:not(.motion) .hero__hint {
    display: none;
  }
  html:not(.motion) .hero__title {
    top: 5.5%;
  }
  @media (max-width: 899px) {
    .hero {
      min-height: 700px;
    }
    .hero__frame {
      clip-path: inset(12% 4% 44% 4%);
    }
    .hero__vf {
      top: 12%;
      bottom: 44%;
    }
    .hero__claim {
      top: 59%;
    }
    .hero__title {
      top: 22%;
    }
    .hero__sub {
      display: none;
    }
    .hero__below {
      bottom: 24px;
    }
  }

  /* Problem */
  .problem__h2 {
    max-width: 11ch;
  }
  .problem__body {
    margin-top: clamp(48px, 8vw, 120px);
    max-width: 30ch;
  }
  @media (min-width: 900px) {
    .problem__body {
      margin-left: 42%;
      max-width: 28ch;
    }
  }

  /* What we do */
  .what__body {
    margin-top: 32px;
  }
  .what :global(.menu) {
    margin-top: clamp(72px, 12vw, 160px);
  }

  /* Results */
  .results__grid {
    margin-top: clamp(56px, 8vw, 104px);
    max-width: 1040px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Sarnia poster */
  .local {
    overflow: hidden;
  }
  .local__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 32px;
  }
  .local__h2 {
    font-size: clamp(64px, 16.8vw, 246px);
    line-height: 0.86;
    letter-spacing: -0.06em;
    text-align: center;
    margin-top: clamp(40px, 6vw, 80px);
    white-space: nowrap;
  }
  .local__body {
    margin-top: clamp(48px, 7vw, 96px);
  }

  /* Final */
  .final__h2 {
    max-width: 12ch;
    margin-left: auto;
    margin-right: auto;
  }
  .final__body {
    margin-top: 32px;
  }
  .final__cta {
    margin-top: clamp(36px, 5vw, 56px);
  }
</style>
