---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Cursor from '../components/Cursor.astro';
import Footer from '../components/Footer.astro';
import Viewfinder from '../components/Viewfinder.astro';
import Marquee from '../components/Marquee.astro';
import Services from '../components/Services.astro';
import WorkGallery from '../components/WorkGallery.astro';
import Testimonials from '../components/Testimonials.astro';
import Stats from '../components/Stats.astro';
import WhoFor from '../components/WhoFor.astro';
import { site, clientNamesSentence } from '../data/site';

const names = clientNamesSentence();
const trusted = names ? `Trusted by ${names} and other companies across Ontario.` : '';
const hero = site.videos.heroLoop;
---

<Base
  title="Real Reach Content. Video marketing for established companies in Sarnia, Ontario."
  description="Real Reach Content makes video for established companies that never built a marketing team. We film it, write it, post it, and run the ads. Sarnia, Ontario."
  path="/"
>
  <Fragment slot="fixed">
    <Nav />
    <Cursor />
  </Fragment>

  <section class="hero theme-dark" data-hero>
    <div class="hero__frame" data-hero-frame>
      <video
        class="hero__video"
        data-hero-video
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={hero.poster}
        aria-hidden="true"
        tabindex="-1"
      >
        <source src={hero.webm} type="video/webm" />
        <source src={hero.mp4} type="video/mp4" />
      </video>
      <div class="hero__shade" aria-hidden="true"></div>
      <div class="grain" aria-hidden="true"></div>
    </div>

    <div class="hero__vf" data-hero-vf>
      <Viewfinder clip="A001_C001" />
    </div>

    <p class="hero__caption mono" data-hero-caption aria-hidden="true">Your company is</p>
    <p class="hero__hint mono" data-hero-hint aria-hidden="true">
      <span class="hero__hint-line"></span>Scroll
    </p>

    <div class="wrap hero__content">
      <h1 class="hero__h1">
        <span class="hero__title" data-hero-title>Your company is</span>
        <span class="hero__claim serif accent" data-hero-claim>bigger than it looks online.</span>
      </h1>
      <div class="hero__row">
        <p class="lead hero__sub" data-hero-below>
          Real Reach Content makes video for established companies that never built a marketing
          team. We film it, write it, post it, and run the ads. You show up on camera a few hours a
          month.
        </p>
        <div class="hero__cta" data-hero-below>
          <a href="/call" class="btn btn--primary btn--lg" data-magnetic data-cursor="Book">Book a call</a>
          {trusted && <p class="hero__trust">{trusted}</p>}
        </div>
      </div>
    </div>
  </section>

  <Marquee />

  <main>
    <section class="section theme-bone" id="problem">
      <div class="wrap">
        <span class="label">The problem</span>
        <h2 class="problem__h2" data-lines>Your marketing is someone's side job.</h2>
        <p class="lead lead--big problem__body" data-words>
          Maybe it's an intern. Maybe it's the office manager between everything else. There is no
          plan. Posts go out when someone remembers. The last photo of your shop was taken on a phone
          in bad light. Meanwhile you have a hundred employees and clients across the country. Anyone
          who looks you up would never know.
        </p>
      </div>
    </section>

    <section class="section theme-bone what" id="what-we-do">
      <div class="wrap">
        <div class="split">
          <div>
            <span class="label">What we do</span>
            <h2 data-lines>We take over your marketing and content.</h2>
          </div>
          <p class="lead measure" data-reveal>
            One team handles the whole thing. We come to you and film. We write what your leaders say
            on camera so it's true and sounds like them. We edit it, post it, and put money behind
            the pieces that bring in clients.
          </p>
        </div>
        <Services />
      </div>
    </section>

    <WorkGallery />

    <section class="section theme-dark results" id="results">
      <div class="grain" aria-hidden="true"></div>
      <div class="wrap">
        <div class="section-head">
          <span class="label">Results</span>
          <h2 data-lines>What clients say.</h2>
        </div>
        <Testimonials max={3} />
        <Stats />
      </div>
    </section>

    <section class="section theme-orange local" id="local">
      <div class="wrap">
        <div class="local__top">
          <span class="label">Sarnia, Ontario</span>
          <span class="mono local__meta">
            <span>42.97° N, 82.40° W</span>
            <span>Now <span data-clock>0:00</span></span>
          </span>
        </div>
        <h2 class="giant" data-lines>We're here.<br />We show up.</h2>
        <p class="lead lead--big measure local__body" data-reveal>
          We come to your shop, your yard, your office. We film your people where they work. Agencies
          you hire off the internet send a brief and hope for the best. We drive over.
        </p>
      </div>
    </section>

    <section class="section theme-bone" id="who">
      <div class="wrap">
        <WhoFor />
      </div>
    </section>

    <section class="section theme-dark final" id="book">
      <div class="grain" aria-hidden="true"></div>
      <div class="wrap">
        <h2 class="giant" data-lines>Book a call with <span class="serif accent">Cayden.</span></h2>
        <div class="final__row">
          <p class="lead lead--big measure" data-reveal>
            Twenty minutes. We look at what you have now, tell you what we'd do, and if it fits you get
            a plan and a price. No slide deck.
          </p>
          <div data-reveal class="final__cta">
            <a href="/call" class="btn btn--primary btn--lg" data-magnetic data-cursor="Book">Book a call</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    import '../scripts/main';
  </script>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    isolation: isolate;
  }
  .hero__frame {
    position: absolute;
    inset: 0;
    z-index: 0;
    clip-path: inset(0 0 0 0);
  }
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(11, 11, 11, 0.2) 0%, rgba(11, 11, 11, 0.35) 55%, rgba(11, 11, 11, 0.88) 100%);
  }
  .hero__vf {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }
  .hero__caption {
    position: absolute;
    top: 17%;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    font-size: 13px;
    letter-spacing: 0.2em;
    color: var(--bone);
    opacity: 0;
    margin: 0;
  }
  .hero__hint {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--muted);
    opacity: 0;
    margin: 0;
  }
  .hero__hint-line {
    display: block;
    width: 1px;
    height: 40px;
    background: currentColor;
  }
  .hero__content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(40px, 7vh, 88px);
    z-index: 3;
  }
  .hero__h1 {
    display: flex;
    flex-direction: column;
    max-width: 12ch;
  }
  .hero__title,
  .hero__claim {
    display: block;
  }
  .hero__claim {
    font-size: 1.12em;
    line-height: 0.92;
  }
  .hero__row {
    display: grid;
    gap: 28px;
    margin-top: clamp(28px, 4vh, 48px);
  }
  @media (min-width: 900px) {
    .hero__row {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      gap: 48px;
      align-items: end;
    }
  }
  .hero__sub {
    max-width: 52ch;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }
  @media (min-width: 900px) {
    .hero__cta {
      justify-content: flex-end;
    }
  }
  .hero__trust {
    font-size: 15px;
    max-width: 34ch;
    color: rgba(243, 239, 232, 0.7);
  }
  /* Without motion, show the hero fully open. */
  html:not(.motion) .hero__vf,
  html:not(.motion) .hero__caption,
  html:not(.motion) .hero__hint {
    display: none;
  }
  @media (max-width: 899px) {
    .hero__h1 {
      max-width: none;
    }
    .hero__caption {
      top: 20%;
    }
  }

  /* Problem */
  .problem__h2 {
    max-width: 12ch;
  }
  .problem__body {
    margin-top: clamp(40px, 6vw, 96px);
    max-width: 30ch;
  }
  @media (min-width: 900px) {
    .problem__body {
      margin-left: auto;
      max-width: 34ch;
    }
  }

  .section-head {
    margin-bottom: clamp(48px, 6vw, 88px);
  }
  .giant {
    font-size: clamp(48px, 10vw, 152px);
    line-height: 0.92;
    letter-spacing: -0.045em;
  }

  /* Local */
  .local__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px 32px;
  }
  .local__meta {
    display: flex;
    gap: 28px;
    color: var(--muted);
  }
  .local__body {
    margin-top: clamp(40px, 6vw, 80px);
  }
  @media (min-width: 900px) {
    .local__body {
      margin-left: auto;
    }
  }

  /* Final */
  .final__row {
    display: grid;
    gap: 32px;
    margin-top: clamp(40px, 6vw, 72px);
  }
  @media (min-width: 900px) {
    .final__row {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
      gap: 48px;
    }
    .final__cta {
      display: flex;
      justify-content: flex-end;
    }
  }
  .results,
  .final {
    overflow: hidden;
  }
</style>
