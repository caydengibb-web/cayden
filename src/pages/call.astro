---
import Base from '../layouts/Base.astro';
import Cursor from '../components/Cursor.astro';
import Footer from '../components/Footer.astro';
import VimeoEmbed from '../components/VimeoEmbed.astro';
import Viewfinder from '../components/Viewfinder.astro';
import Calendly from '../components/Calendly.astro';
import LeadForm from '../components/LeadForm.astro';
import Testimonials from '../components/Testimonials.astro';
import Stats from '../components/Stats.astro';
import WhoFor from '../components/WhoFor.astro';
import { site, clientNamesSentence } from '../data/site';

const names = clientNamesSentence();
const intro = site.videos.callIntro;
---

<Base
  title="Book a call with Cayden. Real Reach Content."
  description="Twenty minutes with Cayden from Real Reach Content. See what video would look like for your company. Sarnia, Ontario."
  path="/call"
  noindex
  bodyClass="page-call"
>
  <Fragment slot="fixed">
    <Cursor />
  </Fragment>

  <header class="top">
    <div class="wrap top__row mono">
      <span>{site.name}</span>
      <span class="muted">{site.city}</span>
    </div>
  </header>

  <main>
    <section class="hero-call" data-hero>
      <div class="wrap">
        <h1 class="hero-call__h1">
          <span class="hero-call__title mono" data-reveal>Your company is</span>
          <span class="hero-call__claim" data-lines>bigger than it looks online.</span>
        </h1>
        <p class="lead narrow hero-call__sub" data-reveal>
          We make video for companies that never built a marketing team. Book a call and Cayden will
          show you what it would look like for yours.
        </p>
        <div class="hero-call__video" data-reveal>
          <VimeoEmbed vimeoId={intro.vimeoId} poster={intro.poster} title="Cayden from Real Reach Content" load="now" autoplayMuted />
          <Viewfinder clip="A002_C001" class="hero-call__vf" />
        </div>
        <div class="hero-call__cta" data-reveal>
          <a href="#calendar" class="btn btn--primary btn--lg" data-scroll-to data-magnetic data-cursor="Pick">Pick a time</a>
          <p class="hero-call__note mono muted">Cayden will call you within one business day if you leave your info instead.</p>
        </div>
      </div>
    </section>

    <section class="section" id="book">
      <div class="wrap">
        <Calendly />
        <div class="form-intro narrow" data-reveal>
          <h2 class="h3">Not ready to pick a time? Leave your info and Cayden will call you.</h2>
          <LeadForm />
        </div>
      </div>
    </section>

    <section class="section results" id="results">
      <div class="wrap">
        <div class="center">
          <span class="label">Results</span>
          <h2 data-lines>What clients say.</h2>
        </div>
        <div class="results__grid">
          <Testimonials max={2} />
        </div>
        {names && <p class="mono muted center clients-line" data-reveal>Clients include {names}.</p>}
        <Stats />
      </div>
    </section>

    <section class="section center" id="what-the-call-is">
      <div class="wrap">
        <h2 data-lines>What the call is</h2>
        <p class="lead--big narrow call-body" data-reveal>
          Twenty minutes on the phone or video. Cayden looks at what you have now. He tells you what
          he'd film first and what it would cost. If it fits, you get a plan. If it doesn't, he'll say
          so.
        </p>
      </div>
    </section>

    <section class="section" id="who">
      <div class="wrap">
        <WhoFor />
      </div>
    </section>

    <section class="section final center" id="pick">
      <div class="wrap">
        <h2 class="final__h2" data-lines>Pick a time.</h2>
        <div class="final__cta" data-reveal>
          <a href="#calendar" class="btn btn--primary btn--lg" data-scroll-to data-magnetic data-cursor="Pick">Pick a time</a>
        </div>
      </div>
    </section>
  </main>

  <Footer minimal />

  <script>
    import '../scripts/call';
  </script>
</Base>

<style>
  .top {
    padding-top: 20px;
  }
  .top__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .hero-call {
    padding: clamp(64px, 12vh, 140px) 0 var(--section);
    text-align: center;
  }
  .hero-call__h1 {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }
  .hero-call__title {
    letter-spacing: 0.22em;
    font-size: 12px;
  }
  .hero-call__claim {
    display: block;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(40px, 7.4vw, 108px);
    letter-spacing: -0.05em;
    line-height: 0.94;
    max-width: 12ch;
  }
  .hero-call__sub {
    margin-top: clamp(28px, 4vw, 40px);
  }
  .hero-call__video {
    position: relative;
    margin: clamp(48px, 7vw, 88px) auto 0;
    max-width: 1100px;
  }
  .hero-call__vf {
    z-index: 4;
  }
  .hero-call__cta {
    margin-top: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }
  .hero-call__note {
    max-width: 44ch;
    text-align: center;
  }
  .form-intro {
    margin-top: clamp(72px, 10vw, 120px);
  }
  .h3 {
    font-size: clamp(26px, 3vw, 40px);
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .results__grid {
    margin-top: clamp(56px, 8vw, 104px);
    max-width: 1040px;
    margin-left: auto;
    margin-right: auto;
  }
  .clients-line {
    margin-top: 48px;
  }
  .call-body {
    margin-top: clamp(36px, 5vw, 56px);
  }
  .final__h2 {
    font-size: clamp(56px, 12vw, 180px);
    letter-spacing: -0.06em;
  }
  .final__cta {
    margin-top: clamp(36px, 5vw, 56px);
  }
</style>
