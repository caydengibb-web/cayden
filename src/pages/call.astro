---
import Base from '../layouts/Base.astro';
import Cursor from '../components/Cursor.astro';
import Footer from '../components/Footer.astro';
import VimeoEmbed from '../components/VimeoEmbed.astro';
import Viewfinder from '../components/Viewfinder.astro';
import Calendly from '../components/Calendly.astro';
import LeadForm from '../components/LeadForm.astro';
import Testimonials from '../components/Testimonials.astro';
import Stats from '../components/Stats.astro';
import WhoFor from '../components/WhoFor.astro';
import { site, clientNamesSentence } from '../data/site';

const names = clientNamesSentence();
const intro = site.videos.callIntro;
---

<Base
  title="Book a call with Cayden. Real Reach Content."
  description="Twenty minutes with Cayden from Real Reach Content. See what video would look like for your company. Sarnia, Ontario."
  path="/call"
  noindex
  bodyClass="page-call"
>
  <Fragment slot="fixed">
    <Cursor />
  </Fragment>

  <header class="top">
    <div class="wrap top__row">
      <span class="wordmark"><span class="wordmark__dot" aria-hidden="true"></span>{site.name}</span>
      <span class="mono muted">{site.city}</span>
    </div>
  </header>

  <main>
    <section class="hero-call theme-dark" data-hero>
      <div class="grain" aria-hidden="true"></div>
      <div class="wrap">
        <h1 class="hero-call__h1">
          <span class="hero-call__title" data-lines>Your company is</span>
          <span class="hero-call__claim serif accent" data-lines>bigger than it looks online.</span>
        </h1>
        <p class="lead lead--big measure hero-call__sub" data-reveal>
          We make video for companies that never built a marketing team. Book a call and Cayden will
          show you what it would look like for yours.
        </p>
        <div class="hero-call__video" data-reveal>
          <VimeoEmbed vimeoId={intro.vimeoId} poster={intro.poster} title="Cayden from Real Reach Content" load="now" autoplayMuted />
          <Viewfinder clip="A002_C001" class="hero-call__vf" />
        </div>
        <div class="hero-call__cta" data-reveal>
          <a href="#calendar" class="btn btn--primary btn--lg" data-scroll-to data-magnetic data-cursor="Pick">Pick a time</a>
          <p class="hero-call__note">Cayden will call you within one business day if you leave your info instead.</p>
        </div>
      </div>
    </section>

    <section class="section theme-bone" id="book">
      <div class="wrap">
        <Calendly />
        <div class="form-intro" data-reveal>
          <h2 class="h3">Not ready to pick a time? Leave your info and Cayden will call you.</h2>
          <LeadForm />
        </div>
      </div>
    </section>

    <section class="section theme-dark results" id="results">
      <div class="grain" aria-hidden="true"></div>
      <div class="wrap">
        <div class="section-head">
          <span class="label">Results</span>
          <h2 data-lines>What clients say.</h2>
        </div>
        <Testimonials max={2} />
        {names && <p class="lead muted clients-line" data-reveal>Clients include {names}.</p>}
        <Stats />
      </div>
    </section>

    <section class="section theme-orange" id="what-the-call-is">
      <div class="wrap split">
        <div>
          <h2 data-lines>What the call is</h2>
        </div>
        <p class="lead lead--big measure" data-reveal>
          Twenty minutes on the phone or video. Cayden looks at what you have now. He tells you what
          he'd film first and what it would cost. If it fits, you get a plan. If it doesn't, he'll say
          so.
        </p>
      </div>
    </section>

    <section class="section theme-bone" id="who">
      <div class="wrap">
        <WhoFor />
      </div>
    </section>

    <section class="section theme-dark final" id="pick">
      <div class="grain" aria-hidden="true"></div>
      <div class="wrap final__row">
        <h2 class="giant" data-lines>Pick a <span class="serif accent">time.</span></h2>
        <div class="final__cta" data-reveal>
          <a href="#calendar" class="btn btn--primary btn--lg" data-scroll-to data-magnetic data-cursor="Pick">Pick a time</a>
        </div>
      </div>
    </section>
  </main>

  <Footer minimal />

  <script>
    import '../scripts/call';
  </script>
</Base>

<style>
  .top {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 5;
    padding-top: 24px;
    color: var(--bone);
  }
  .top__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    letter-spacing: -0.02em;
    font-size: 17px;
  }
  .wordmark__dot {
    width: 8px;
    height: 8px;
    background: var(--orange);
  }
  .hero-call {
    position: relative;
    padding: clamp(96px, 14vh, 160px) 0 var(--section);
    overflow: hidden;
  }
  .hero-call__h1 {
    display: flex;
    flex-direction: column;
    max-width: 12ch;
  }
  .hero-call__title,
  .hero-call__claim {
    display: block;
  }
  .hero-call__claim {
    font-size: 1.12em;
    line-height: 0.92;
  }
  .hero-call__sub {
    margin-top: clamp(28px, 4vw, 48px);
  }
  .hero-call__video {
    position: relative;
    margin-top: clamp(40px, 6vw, 72px);
  }
  .hero-call__vf {
    z-index: 4;
  }
  .hero-call__cta {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }
  .hero-call__note {
    font-size: 15px;
    max-width: 40ch;
    color: rgba(243, 239, 232, 0.7);
  }
  .form-intro {
    margin-top: clamp(64px, 8vw, 96px);
    padding-top: 56px;
    border-top: 1px solid var(--rule);
  }
  .h3 {
    font-size: clamp(28px, 3.4vw, 48px);
    letter-spacing: -0.03em;
    line-height: 1.05;
    max-width: 24ch;
  }
  .section-head {
    margin-bottom: clamp(48px, 6vw, 88px);
  }
  .clients-line {
    margin-top: 40px;
  }
  .giant {
    font-size: clamp(48px, 10vw, 152px);
    line-height: 0.92;
    letter-spacing: -0.045em;
  }
  .final__row {
    display: grid;
    gap: 32px;
  }
  @media (min-width: 900px) {
    .final__row {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
    }
    .final__cta {
      display: flex;
      justify-content: flex-end;
    }
  }
  .results,
  .final {
    overflow: hidden;
  }
</style>
